# Public values only. Anything here ends up in the browser.
# In production the Firebase config is read from /__/firebase/init.json (served by Firebase Hosting),
# so these are needed only for local development.
VITE_PUBLIC_FIREBASE_API_KEY=
VITE_PUBLIC_FIREBASE_AUTH_DOMAIN=
VITE_PUBLIC_FIREBASE_PROJECT_ID=
VITE_PUBLIC_FIREBASE_STORAGE_BUCKET=
VITE_PUBLIC_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key for App Check (public by design)
VITE_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=
# Set to "true" to talk to the local emulators
VITE_PUBLIC_USE_EMULATORS=false
